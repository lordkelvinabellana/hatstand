  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The principal create or save action.",
      "html": "<button type=\"button\" class=\"ds-button-primary\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M12 5v14\"/></svg>Add profile</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;background:transparent;color:var(--ink,#242c29);font-family:'Segoe UI',system-ui,sans-serif;font-weight:600;font-size:13px;border-radius:7px;cursor:pointer;transition:background .14s ease-out}.ds-button-primary:hover:not(:disabled){background:var(--hover,#f0f3ed)}.ds-button-primary:focus-visible{outline:2px solid var(--accent,#236553);outline-offset:3px}.ds-button-primary:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}.ds-button-primary{background:var(--accent,#236553);color:#fff;padding:11px 15px;white-space:nowrap}.ds-button-primary:hover:not(:disabled){background:#174c3e}:host-context([data-theme=dark]) .ds-button-primary{background:#94d4b6;color:#172a20}:host-context([data-theme=dark]) .ds-button-primary:hover:not(:disabled){background:#b1e2ca}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A bordered supporting action on the current surface.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Browse</button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;background:transparent;color:var(--ink,#242c29);font-family:'Segoe UI',system-ui,sans-serif;font-weight:600;font-size:13px;border-radius:7px;cursor:pointer;transition:background .14s ease-out}.ds-button-secondary:hover:not(:disabled){background:var(--hover,#f0f3ed)}.ds-button-secondary:focus-visible{outline:2px solid var(--accent,#236553);outline-offset:3px}.ds-button-secondary:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}.ds-button-secondary{border:1px solid var(--line,#dfe3da);background:var(--surface,#fff);padding:9px 12px;white-space:nowrap}"
    },
    {
      "name": "Launch Button",
      "kind": "button",
      "refersTo": "button-launch",
      "description": "Compact action in a ready profile row.",
      "html": "<button type=\"button\" class=\"ds-button-launch\">Launch<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button>",
      "css": ".ds-button-launch{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;background:transparent;color:var(--ink,#242c29);font-family:'Segoe UI',system-ui,sans-serif;font-weight:600;font-size:13px;border-radius:7px;cursor:pointer;transition:background .14s ease-out}.ds-button-launch:hover:not(:disabled){background:var(--hover,#f0f3ed)}.ds-button-launch:focus-visible{outline:2px solid var(--accent,#236553);outline-offset:3px}.ds-button-launch:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-launch{transition:none}}.ds-button-launch{border:1px solid var(--line,#dfe3da);padding:8px 9px;font-size:11px}"
    },
    {
      "name": "Focus Button",
      "kind": "button",
      "refersTo": "button-focus",
      "description": "Compact soft-accent action for an observed running profile.",
      "html": "<button type=\"button\" class=\"ds-button-focus\">Focus<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button>",
      "css": ".ds-button-focus{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;background:transparent;color:var(--ink,#242c29);font-family:'Segoe UI',system-ui,sans-serif;font-weight:600;font-size:13px;border-radius:7px;cursor:pointer;transition:background .14s ease-out}.ds-button-focus:hover:not(:disabled){background:var(--hover,#f0f3ed)}.ds-button-focus:focus-visible{outline:2px solid var(--accent,#236553);outline-offset:3px}.ds-button-focus:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-focus{transition:none}}.ds-button-focus{background:var(--accent-soft,#e2eee7);color:var(--accent,#236553);padding:8px 9px;font-size:11px}"
    },
    {
      "name": "Text Button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "A lightweight supporting link-style action.",
      "html": "<button type=\"button\" class=\"ds-button-text\">Download Claude Desktop<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button>",
      "css": ".ds-button-text{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;background:transparent;color:var(--ink,#242c29);font-family:'Segoe UI',system-ui,sans-serif;font-weight:600;font-size:13px;border-radius:7px;cursor:pointer;transition:background .14s ease-out}.ds-button-text:hover:not(:disabled){background:var(--hover,#f0f3ed)}.ds-button-text:focus-visible{outline:2px solid var(--accent,#236553);outline-offset:3px}.ds-button-text:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button-text{transition:none}}.ds-button-text{font-size:12px;color:var(--accent,#236553);padding:5px 0}"
    },
    {
      "name": "Labeled Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible editor label, optional cue, muted help, and shared keyboard focus.",
      "html": "<label class=\"ds-field-label\">Account label <span class=\"ds-field-optional\">optional</span><input class=\"ds-field-input\" maxlength=\"160\" placeholder=\"Work account or email\"/><small class=\"ds-field-help\">A label you enter, not a verified account identity.</small></label>",
      "css": ".ds-field-label{display:flex;flex-direction:column;gap:7px;font-family:'Segoe UI',system-ui,sans-serif;font-size:12px;font-weight:600;color:var(--ink,#242c29);margin:17px 0}.ds-field-optional{font-weight:400;color:var(--muted,#626b64)}.ds-field-input{font:inherit;color:var(--ink,#242c29);background:var(--field,#fff);border:1px solid var(--line,#dfe3da);border-radius:6px;padding:10px 12px;min-width:0;caret-color:var(--accent,#236553)}.ds-field-input::placeholder{color:var(--muted,#626b64)}.ds-field-input:focus-visible{outline:2px solid var(--accent,#236553);outline-offset:3px}.ds-field-help{font-size:11px;font-weight:400;line-height:1.5;color:var(--muted,#626b64)}"
    },
    {
      "name": "Active Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Full-width active sidebar button; the compact rail retains its accessible name.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button type=\"button\" class=\"ds-nav-active\" aria-label=\"Client profiles\" title=\"Client profiles\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"7\" height=\"7\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"7\" x=\"3\" y=\"14\" rx=\"1\"/><path d=\"M14 4h7M14 9h7M14 15h7M14 20h7\"/></svg><span class=\"ds-nav-label\">Client profiles</span><span class=\"ds-nav-count\">2</span></button></nav>",
      "css": ".ds-nav-active{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;background:transparent;color:var(--ink,#242c29);font-family:'Segoe UI',system-ui,sans-serif;font-weight:600;font-size:13px;border-radius:7px;cursor:pointer;transition:background .14s ease-out}.ds-nav-active:hover:not(:disabled){background:var(--hover,#f0f3ed)}.ds-nav-active:focus-visible{outline:2px solid var(--accent,#236553);outline-offset:3px}.ds-nav-active:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-nav-active{transition:none}}.ds-nav{max-width:174px;padding:10px;background:var(--sidebar,#eeefe8)}.ds-nav-active{width:100%;justify-content:flex-start;padding:11px 12px;margin:3px 0;background:var(--surface,#fff);color:var(--accent,#236553)}.ds-nav-label{flex:1;text-align:left}.ds-nav-count{font-size:11px;border-radius:4px;padding:1px 6px;background:var(--accent-soft,#e2eee7)}@media(max-width:800px){.ds-nav{max-width:52px}.ds-nav-active{justify-content:center;padding:12px}.ds-nav-label,.ds-nav-count{display:none}}"
    },
    {
      "name": "Preview Label",
      "kind": "chip",
      "refersTo": "preview-label",
      "description": "A noninteractive, soft-accent build-status tag.",
      "html": "<span class=\"ds-preview\">Preview build</span>",
      "css": ".ds-preview{font-family:'Segoe UI',system-ui,sans-serif;font-size:11px;padding:6px 10px;border-radius:5px;background:var(--accent-soft,#e2eee7);color:var(--accent,#236553);white-space:nowrap}"
    },
    {
      "name": "Profiles Panel",
      "kind": "card",
      "refersTo": "profiles-panel",
      "description": "Flat bordered container and the shipped empty-state treatment.",
      "html": "<section class=\"ds-panel\" aria-label=\"Client profiles\"><div class=\"ds-empty\"><h2 class=\"ds-empty-title\">Make room for your first client</h2><p class=\"ds-empty-copy\">Create a profile, then sign in inside Claude Desktop.</p><button type=\"button\" class=\"ds-panel-create\">Create a profile</button></div></section>",
      "css": ".ds-panel{font-family:'Segoe UI',system-ui,sans-serif;min-width:0;border:1px solid var(--line,#dfe3da);border-radius:10px;background:var(--surface,#fff)}.ds-empty{text-align:center;padding:52px 24px 58px;color:var(--muted,#626b64)}.ds-empty-title{font-size:16px;line-height:1.5;font-weight:600;color:var(--ink,#242c29);margin:18px 0 0}.ds-empty-copy{font-size:13px;line-height:1.65;margin:8px auto 20px;max-width:36ch}.ds-panel-create{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;background:transparent;color:var(--ink,#242c29);font-family:'Segoe UI',system-ui,sans-serif;font-weight:600;font-size:13px;border-radius:7px;cursor:pointer;transition:background .14s ease-out}.ds-panel-create:hover:not(:disabled){background:var(--hover,#f0f3ed)}.ds-panel-create:focus-visible{outline:2px solid var(--accent,#236553);outline-offset:3px}.ds-panel-create:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-panel-create{transition:none}}.ds-panel-create{background:var(--accent,#236553);color:#fff;padding:11px 15px;white-space:nowrap}.ds-panel-create:hover:not(:disabled){background:#174c3e}:host-context([data-theme=dark]) .ds-panel-create{background:#94d4b6;color:#172a20}:host-context([data-theme=dark]) .ds-panel-create:hover:not(:disabled){background:#b1e2ca}"
    },
    {
      "name": "Client Profile Row",
      "kind": "custom",
      "refersTo": "profile-row",
      "description": "Illustrative client identity, written process status, and compact launch action in the shipped row geometry.",
      "html": "<article class=\"ds-row\"><button type=\"button\" class=\"ds-identity\"><span class=\"ds-avatar\">NS</span><span class=\"ds-name\"><strong class=\"ds-client-name\">North Studio</strong><span class=\"ds-account\">Work account</span></span></button><span class=\"ds-status\"><span class=\"ds-dot\"></span>Ready to launch</span><div class=\"ds-actions\"><button type=\"button\" class=\"ds-row-launch\">Launch<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button><button type=\"button\" class=\"ds-more\" aria-label=\"Actions for North Studio\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"1\"/><circle cx=\"19\" cy=\"12\" r=\"1\"/><circle cx=\"5\" cy=\"12\" r=\"1\"/></svg></button></div></article>",
      "css": ".ds-identity{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;background:transparent;color:var(--ink,#242c29);font-family:'Segoe UI',system-ui,sans-serif;font-weight:600;font-size:13px;border-radius:7px;cursor:pointer;transition:background .14s ease-out}.ds-identity:hover:not(:disabled){background:var(--hover,#f0f3ed)}.ds-identity:focus-visible{outline:2px solid var(--accent,#236553);outline-offset:3px}.ds-identity:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-identity{transition:none}}.ds-row-launch{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;background:transparent;color:var(--ink,#242c29);font-family:'Segoe UI',system-ui,sans-serif;font-weight:600;font-size:13px;border-radius:7px;cursor:pointer;transition:background .14s ease-out}.ds-row-launch:hover:not(:disabled){background:var(--hover,#f0f3ed)}.ds-row-launch:focus-visible{outline:2px solid var(--accent,#236553);outline-offset:3px}.ds-row-launch:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-row-launch{transition:none}}.ds-more{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;background:transparent;color:var(--ink,#242c29);font-family:'Segoe UI',system-ui,sans-serif;font-weight:600;font-size:13px;border-radius:7px;cursor:pointer;transition:background .14s ease-out}.ds-more:hover:not(:disabled){background:var(--hover,#f0f3ed)}.ds-more:focus-visible{outline:2px solid var(--accent,#236553);outline-offset:3px}.ds-more:disabled{cursor:default;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-more{transition:none}}.ds-row{display:grid;grid-template-columns:minmax(160px,1fr) 115px 105px;gap:12px;align-items:center;padding:22px 18px;border-bottom:1px solid var(--line,#dfe3da);background:var(--surface,#fff);font-family:'Segoe UI',system-ui,sans-serif;color:var(--ink,#242c29)}.ds-identity{justify-content:flex-start;text-align:left;min-width:0;padding:0;gap:13px}.ds-identity:hover:not(:disabled){background:transparent}.ds-avatar{width:43px;height:43px;border-radius:10px;display:inline-flex;align-items:center;justify-content:center;font-size:14px;font-weight:650;flex-shrink:0;background:#dbeae4;color:#245a49}.ds-name{display:flex;flex-direction:column;gap:5px;min-width:0}.ds-client-name{font-size:14px;font-weight:600;overflow-wrap:anywhere}.ds-account{font-size:11px;font-weight:400;color:var(--muted,#626b64);text-overflow:ellipsis;overflow:hidden;white-space:nowrap}.ds-status{display:flex;align-items:center;gap:6px;font-size:10px;color:var(--muted,#626b64);white-space:nowrap}.ds-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#76827a;flex-shrink:0}.ds-actions{display:flex;align-items:center;gap:3px;justify-content:flex-end}.ds-row-launch{padding:8px 9px;font-size:11px;border:1px solid var(--line,#dfe3da)}.ds-more{width:31px;height:31px;color:var(--muted,#626b64);padding:0}@media(max-width:800px){.ds-row{grid-template-columns:minmax(140px,1fr) 104px 98px;gap:6px;padding:18px 14px}.ds-identity{gap:10px}}"
    }
  ],
  "narrative": {
    "northStar": "The Compact Client Desk",
    "overview": "ClientDeck is a calm Windows working surface. Its identity comes from purposeful Segoe UI typography, warm neutral surfaces, restrained teal actions, and compact client rows. Clear client names, initials, and written status keep the utility readable during everyday switching.\n\nThe approved compact utility direction governs the system. Group separation gives controls room without turning each record into a large card. Light and dark themes share the same geometry and hierarchy; color changes the material, not the meaning. This document captures the shipped interface in `src/ui/style.css` and `src/ui/index.tsx`; the north-star name describes the already selected direction.",
    "keyCharacteristics": [
      "Native Windows typography with compact, readable hierarchy.",
      "Warm light surfaces and green-tinted dark surfaces.",
      "Teal actions, thin dividers, and small outlined icons.",
      "Client identity and status expressed with text as well as color.",
      "Visible keyboard focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Written Status Rule",
        "body": "Color supports a written state or identifiable client name; it never carries the meaning alone.",
        "section": "colors"
      },
      {
        "name": "The Native Type Rule",
        "body": "Use the shipped Segoe UI stack for application copy and controls; preserve the text hierarchy across both themes.",
        "section": "typography"
      },
      {
        "name": "The Temporary Layer Rule",
        "body": "Reserve the existing shadow for the floating actions menu; use tone and separators for persistent surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the native Segoe UI hierarchy and compact control density.",
      "**Do** keep names, initials, and written status legible in both themes.",
      "**Do** use the shared accent focus outline for keyboard-operable controls.",
      "**Do** preserve accessible names when navigation labels collapse.",
      "**Do** honor reduced-motion preference for transitions and animations."
    ],
    "donts": [
      "**Don't** use color alone to identify a client or process state.",
      "**Don't** add resting shadows to list rows or permanent panels.",
      "**Don't** replace the approved compact utility surface with a marketing hero or metric tiles.",
      "**Don't** infer account identity, task completion, or Cowork compatibility from visual process status."
    ]
  }
}
