{
  "name": "hatstand",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source Windows and macOS launcher that keeps each client’s Claude Desktop account in its own profile.",
  "keywords": [
    "claude",
    "claude-desktop",
    "profiles",
    "windows",
    "electron",
    "launcher",
    "macos"
  ],
  "homepage": "https://github.com/lordkelvinabellana/hatstand#readme",
  "bugs": {
    "url": "https://github.com/lordkelvinabellana/hatstand/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lordkelvinabellana/hatstand.git"
  },
  "license": "MIT",
  "author": "Hatstand contributors",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "probe": "node scripts/dev/probe.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "package": "npm run build && node scripts/package.mjs",
    "make": "npm run package && electron-forge make --skip-package",
    "test:ui": "node scripts/verify-ui.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:macos": "node scripts/verify-macos.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.2",
    "esbuild": "^0.28.2",
    "graphology-types": "^0.24.8",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/markdown": "^1.8.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^1.57.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sigma": "^3.0.3"
  },
  "overrides": {
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "@electron/packager": "^20.3.0"
  }
}
